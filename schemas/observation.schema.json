{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "CrowdWatch canonical observation v1",
  "description": "Runtime validation additionally enforces timestamp ordering, source references, JSON details length and credential-free provenance. Dates use an explicit UTC offset.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "source_id",
    "stream_id",
    "region_id",
    "metric",
    "value",
    "unit",
    "observed_at",
    "retrieved_at",
    "valid_until"
  ],
  "properties": {
    "source_id": {
      "type": "string",
      "pattern": "^[a-zA-Z0-9][a-zA-Z0-9_.:-]{0,127}$"
    },
    "stream_id": {
      "type": "string",
      "pattern": "^[a-zA-Z0-9][a-zA-Z0-9_.:-]{0,127}$"
    },
    "region_id": {
      "type": "string",
      "pattern": "^[a-zA-Z0-9][a-zA-Z0-9_.:-]{0,127}$"
    },
    "metric": {
      "enum": [
        "footfall",
        "occupancy",
        "inflow",
        "outflow",
        "speed",
        "density",
        "transit_disruption",
        "scheduled_event",
        "temperature",
        "precipitation",
        "wind",
        "bikes_available",
        "docks_available",
        "report"
      ]
    },
    "unit": {
      "enum": [
        "degC",
        "docks",
        "event",
        "index",
        "km/h",
        "m/s",
        "mm/interval",
        "people",
        "people/interval",
        "people/m2",
        "people/min",
        "report",
        "vehicles"
      ]
    },
    "value": {
      "type": "number",
      "minimum": -100,
      "maximum": 1000000000000.0
    },
    "observed_at": {
      "type": "string",
      "format": "date-time",
      "pattern": "(Z|[+-][0-9]{2}:[0-9]{2})$"
    },
    "retrieved_at": {
      "type": "string",
      "format": "date-time",
      "pattern": "(Z|[+-][0-9]{2}:[0-9]{2})$"
    },
    "valid_until": {
      "type": "string",
      "format": "date-time",
      "pattern": "(Z|[+-][0-9]{2}:[0-9]{2})$"
    },
    "period_seconds": {
      "type": "integer",
      "minimum": 0,
      "maximum": 86400,
      "default": 0
    },
    "quality": {
      "type": "number",
      "minimum": 0,
      "maximum": 1,
      "default": 1
    },
    "provenance_url": {
      "type": "string",
      "pattern": "^$|^https://[^/?#@]+[^?#]*$",
      "default": ""
    },
    "label": {
      "type": "string",
      "maxLength": 500,
      "default": ""
    },
    "latitude": {
      "type": [
        "number",
        "null"
      ],
      "minimum": -90,
      "maximum": 90
    },
    "longitude": {
      "type": [
        "number",
        "null"
      ],
      "minimum": -180,
      "maximum": 180
    },
    "details": {
      "type": "object",
      "default": {}
    }
  },
  "allOf": [
    {
      "if": {
        "properties": {
          "metric": {
            "const": "footfall"
          }
        }
      },
      "then": {
        "properties": {
          "unit": {
            "const": "people/interval"
          },
          "value": {
            "type": "number",
            "minimum": 0,
            "maximum": 1000000000000.0
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "metric": {
            "const": "occupancy"
          }
        }
      },
      "then": {
        "properties": {
          "unit": {
            "const": "people"
          },
          "value": {
            "type": "number",
            "minimum": 0,
            "maximum": 1000000000000.0
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "metric": {
            "const": "inflow"
          }
        }
      },
      "then": {
        "properties": {
          "unit": {
            "const": "people/min"
          },
          "value": {
            "type": "number",
            "minimum": 0,
            "maximum": 1000000000000.0
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "metric": {
            "const": "outflow"
          }
        }
      },
      "then": {
        "properties": {
          "unit": {
            "const": "people/min"
          },
          "value": {
            "type": "number",
            "minimum": 0,
            "maximum": 1000000000000.0
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "metric": {
            "const": "speed"
          }
        }
      },
      "then": {
        "properties": {
          "unit": {
            "const": "m/s"
          },
          "value": {
            "type": "number",
            "minimum": 0,
            "maximum": 1000000000000.0
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "metric": {
            "const": "density"
          }
        }
      },
      "then": {
        "properties": {
          "unit": {
            "const": "people/m2"
          },
          "value": {
            "type": "number",
            "minimum": 0,
            "maximum": 1000000000000.0
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "metric": {
            "const": "transit_disruption"
          }
        }
      },
      "then": {
        "properties": {
          "unit": {
            "const": "index"
          },
          "value": {
            "type": "number",
            "minimum": 0,
            "maximum": 1
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "metric": {
            "const": "scheduled_event"
          }
        }
      },
      "then": {
        "properties": {
          "unit": {
            "const": "event"
          },
          "value": {
            "type": "number",
            "minimum": 0,
            "maximum": 1000000000000.0
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "metric": {
            "const": "temperature"
          }
        }
      },
      "then": {
        "properties": {
          "unit": {
            "const": "degC"
          },
          "value": {
            "type": "number",
            "minimum": -100,
            "maximum": 1000000000000.0
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "metric": {
            "const": "precipitation"
          }
        }
      },
      "then": {
        "properties": {
          "unit": {
            "const": "mm/interval"
          },
          "value": {
            "type": "number",
            "minimum": 0,
            "maximum": 1000000000000.0
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "metric": {
            "const": "wind"
          }
        }
      },
      "then": {
        "properties": {
          "unit": {
            "const": "km/h"
          },
          "value": {
            "type": "number",
            "minimum": 0,
            "maximum": 1000000000000.0
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "metric": {
            "const": "bikes_available"
          }
        }
      },
      "then": {
        "properties": {
          "unit": {
            "const": "vehicles"
          },
          "value": {
            "type": "number",
            "minimum": 0,
            "maximum": 1000000000000.0
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "metric": {
            "const": "docks_available"
          }
        }
      },
      "then": {
        "properties": {
          "unit": {
            "const": "docks"
          },
          "value": {
            "type": "number",
            "minimum": 0,
            "maximum": 1000000000000.0
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "metric": {
            "const": "report"
          }
        }
      },
      "then": {
        "properties": {
          "unit": {
            "const": "report"
          },
          "value": {
            "type": "number",
            "minimum": 0,
            "maximum": 1000000000000.0
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "metric": {
            "enum": [
              "footfall",
              "precipitation"
            ]
          }
        }
      },
      "then": {
        "required": [
          "period_seconds"
        ],
        "properties": {
          "period_seconds": {
            "minimum": 1
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "metric": {
            "const": "scheduled_event"
          }
        }
      },
      "then": {
        "required": [
          "details"
        ],
        "properties": {
          "details": {
            "required": [
              "starts_at",
              "ends_at"
            ],
            "properties": {
              "starts_at": {
                "type": "string",
                "format": "date-time",
                "pattern": "(Z|[+-][0-9]{2}:[0-9]{2})$"
              },
              "ends_at": {
                "type": "string",
                "format": "date-time",
                "pattern": "(Z|[+-][0-9]{2}:[0-9]{2})$"
              }
            }
          }
        }
      }
    },
    {
      "if": {
        "required": [
          "latitude"
        ],
        "properties": {
          "latitude": {
            "type": "number"
          }
        }
      },
      "then": {
        "required": [
          "longitude"
        ],
        "properties": {
          "longitude": {
            "type": "number"
          }
        }
      }
    },
    {
      "if": {
        "required": [
          "longitude"
        ],
        "properties": {
          "longitude": {
            "type": "number"
          }
        }
      },
      "then": {
        "required": [
          "latitude"
        ],
        "properties": {
          "latitude": {
            "type": "number"
          }
        }
      }
    }
  ]
}
